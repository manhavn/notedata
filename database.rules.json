{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "notes": {
          "$noteId": {
            ".validate": "newData.hasChildren(['title', 'content', 'createdAt', 'updatedAt']) && newData.child('title').isString() && newData.child('content').isString() && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber()"
          }
        }
      }
    }
  }
}